# Copy to .env and fill in. .env is gitignored.

# Required for per-alert AI explanations (Settings → Alerts tab)
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override Grafana admin password (default: admin)
# GRAFANA_PASSWORD=

# Optional: enable "Sign in with GitHub" on the dashboard.
# Register an OAuth App at https://github.com/settings/developers
#   - Authorization callback URL: http://localhost:8501/ (or your real domain)
# Then drop the three values below. ALLOWED_GITHUB_USERS is an optional
# comma-separated allowlist; leave blank to allow any GitHub user.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:8501/
# ALLOWED_GITHUB_USERS=udayak
